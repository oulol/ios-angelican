+#endif
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
-#if !VMAPPLE
+#if !VMAPPLE && !defined(ANGELICAN)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
 	bne		.
-#endif /* !VMAPPLE */
+#endif /* !VMAPPLE && !ANGELICAN */
 
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
@@ -780,11 +784,11 @@ common_start:
 	APPLY_TUNABLES x12, x13, x14
 
 
-#if HAS_CLUSTER
-	// Unmask external IRQs if we're restarting from non-retention WFI
-	mrs		x9, CPU_OVRD
-	and		x9, x9, #(~(ARM64_REG_CYC_OVRD_irq_mask | ARM64_REG_CYC_OVRD_fiq_mask))
-	msr		CPU_OVRD, x9
+#if HAS_CLUSTER && !defined(NO_CPU_OVRD)
+    // Unmask external IRQs if we're restarting from non-retention WFI
+    mrs     x9, CPU_OVRD
+    and     x9, x9, #(~(ARM64_REG_CYC_OVRD_irq_mask | ARM64_REG_CYC_OVRD_fiq_mask))
+    msr     CPU_OVRD, x9
 #endif
 
 	// If x21 != 0, we're doing a warm reset, so we need to trampoline to the kernel pmap.
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 3ad743f..9ba11d4 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -141,20 +141,40 @@ pe_init_fiq()
 		}
 	}
 
+#if defined(ANGELICAN)
+	/*
+	 * Real hardware with two security states: Group 0 is TrustZone's and
+	 * non-secure writes to it are ignored. Everything we own is Group 1 NS
+	 * and arrives as an IRQ (see sleh_irq). GICR_IGROUPR0 reads as zero
+	 * from the non-secure side even after this write; delivery still works.
+	 */
+	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicr_write32(GICR_ISENABLER0, 
+		(1U << ANGELICAN_VTIMER_INITD) | 
+		(1U << ANGELICAN_IPI_SGI)
+	);
+#else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
 
 	// Enable PPI 27
 	gicr_write32(GICR_ISENABLER0, (1 << 27));
-
+#endif /* ANGELICAN */
 	// Enable system register access
 	uint64_t icc_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
 	icc_sre |= ICC_SRE_SRE;
 	__builtin_arm_wsr64("ICC_SRE_EL1", icc_sre);
 	__builtin_arm_isb(ISB_SY);
 
-	// Set priority masks and binary point for group 0
-	__builtin_arm_wsr64("ICC_BPR0_EL1", 0);
+#if defined(ANGELICAN)
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+#else
+ 	// Set priority masks and binary point for group 0
+ 	__builtin_arm_wsr64("ICC_BPR0_EL1", 0);
+#endif /* ANGELICAN */
 	__builtin_arm_wsr64("ICC_PMR_EL1", 0xFF);
 
 	// Set EOI mode of this processor
@@ -162,12 +182,24 @@ pe_init_fiq()
 	icc_ctlr &= ~ICC_CTLR_EOIMODE;
 	__builtin_arm_wsr64("ICC_CTLR_EL1", icc_ctlr);
 
-	// Enable the forwarding of the vtimer interrupt
+#if defined(ANGELICAN)
+	// ABL leaves only ARE_NS set; Linux writes ARE_NS | EnableGrp1A | EnableGrp1
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
-	gicd_ctlr |= GICD_CTLR_ENABLEGRP0;
+	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
-	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
+#else
+ 	// Enable the forwarding of the vtimer interrupt
+ 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+ 	gicd_ctlr |= GICD_CTLR_ENABLEGRP0;
+ 	gicd_write32(GICD_CTLR, gicd_ctlr);
+ 	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
+ 	__builtin_arm_isb(ISB_SY);
+#endif /* ANGELICAN */
 }
 #else
 void
diff --git a/pexpert/pexpert/arm64/ANGELICAN.h b/pexpert/pexpert/arm64/ANGELICAN.h
new file mode 100644
index 0000000..a9f5388
--- /dev/null
+++ b/pexpert/pexpert/arm64/ANGELICAN.h
@@ -0,0 +1,75 @@
+/*
+ * Board configuration for Xiaomi Redmi 9C NFC ("angelican").
+ *
+ * SoC: MediaTek MT6765
+ * CPU: 8x ARM Cortex-A53
+ * CPU topology: 2 clusters, 4 cores per cluster
+ * Architecture: ARMv8-A
+ * Interrupt controller: GICv3
+ * Translation granule: 4 KiB
+ *
+ * This configuration does not enable Apple-specific CPU extensions.
+ */
+
+#ifndef _PEXPERT_ARM64_ANGELICAN_H
+#define _PEXPERT_ARM64_ANGELICAN_H
+
+#define NO_MONITOR                  1
+#define NO_ECORE                    1
+
+#define ANGELICAN                   1
+
+#define ARM_ARCH_TIMER
+
+#define __ARM_ARCH__                8
+#define __ARM_VMSA__                8
+#define __ARM_VFP__                 4
+#define __ARM_COHERENT_CACHE__      1
+#define __ARM_DEBUG__               7
+#define __ARM_ENABLE_SWAP__         1
+
+#define HAS_CLUSTER 1
+#define NO_CPU_OVRD 1
+
+#define HAS_GIC_V3                  1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/* The architected virtual timer is PPI 11, INTID 27. */
+#define ANGELICAN_VTIMER_PPI        11
+#define ANGELICAN_VTIMER_INTID      27
+#define ANGELICAN_IPI_SGI           1
+
+/* GICv3 definitions */
+#define GIC_SPURIOUS_IRQ            1023
+#define GICR_PE_SIZE                0x20000
+
+/* GIC Distributor */
+#define GICD_CTLR                   0x0000
+#define GICD_CTLR_ENABLEGRP0        (1U << 0)
+#define GICD_CTLR_ENABLEGRP1        (1U << 0)
+#define GICD_CTLR_ENABLEGRP1A       (1U << 1)
+#define GICD_CTLR_ARE_NS            (1U << 4)
+#define GICD_CTLR_RWP               (1U << 31)
+
+/* GIC Redistributor */
+#define GICR_TYPER                 0x0008
+#define GICR_WAKER                 0x0014
+
+#define GICR_IGROUPR0              0x10080
+#define GICR_ISENABLER0            0x10100
+#define GICR_IPRIORITYR0           0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT 32
+#define GICR_TYPER_LAST            (1ULL << 4)
+
+#define GICR_WAKER_PROCESSORSLEEP  (1U << 1)
+#define GICR_WAKER_CHILDRENASLEEP  (1U << 2)
+
+/* CPU interface system registers */
+#define ICC_CTLR_EOIMODE           (1ULL << 1)
+#define ICC_SRE_SRE                (1ULL << 0)
+
+#endif /* ! _PEXPERT_ARM64_ANGELICAN_H */
\ No newline at end of file
