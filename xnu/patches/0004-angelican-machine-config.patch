diff --git a/pexpert/pexpert/arm64/ANGELICAN.h b/pexpert/pexpert/arm64/ANGELICAN.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/ANGELICAN.h
@@ -0,0 +1,65 @@
+/*
+ * Board configuration for Xiaomi Redmi 9C NFC ("angelican").
+ *
+ * SoC: MediaTek MT6765
+ * CPU: 8x ARM Cortex-A53
+ * CPU topology: 2 clusters, 4 cores per cluster
+ * Architecture: ARMv8-A
+ * Interrupt controller: GICv3
+ * Translation granule: 16 KiB
+ *
+ * This configuration does not enable Apple-specific CPU extensions.
+ */
+
+#ifndef _PEXPERT_ARM64_ANGELICAN_H
+#define _PEXPERT_ARM64_ANGELICAN_H
+
+#define NO_MONITOR                  1
+#define NO_ECORE                    1
+
+#define ANGELICAN                   1
+
+#define ARM_ARCH_TIMER
+
+#define __ARM_ARCH__                8
+#define __ARM_VMSA__                8
+#define __ARM_VFP__                 4
+#define __ARM_COHERENT_CACHE__      1
+#define __ARM_DEBUG__               7
+#define __ARM_ENABLE_SWAP__         1
+
+/* The Angelican XNU port uses 16 KiB translation granules. */
+#define __ARM_16K_PG__              1
+
+#define HAS_GIC_V3                  1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/* The architected virtual timer is PPI 11, INTID 27. */
+#define ANGELICAN_VTIMER_PPI        11
+#define ANGELICAN_VTIMER_INTID      27
+
+/* GICv3 register definitions, also used by the XNU GIC implementation. */
+#define GIC_SPURIOUS_IRQ            1023
+#define GICR_PE_SIZE                0x20000
+
+#define GICD_CTLR                   0x0
+#define GICD_CTLR_ENABLEGRP0        0x1
+
+#define GICR_TYPER                  0x08
+#define GICR_WAKER                  0x14
+#define GICR_IGROUPR0               0x10080
+#define GICR_ISENABLER0             0x10100
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT 32
+#define GICR_TYPER_LAST             0x10
+
+#define GICR_WAKER_PROCESSORSLEEP   0x2
+#define GICR_WAKER_CHILDRENASLEEP   0x4
+
+/* ICC_CTLR_EL1.EOImode is bit 1; ICC_SRE_EL1.SRE is bit 0. */
+#define ICC_CTLR_EOIMODE            0x2
+#define ICC_SRE_SRE                 0x1
+
+#endif /* ! _PEXPERT_ARM64_ANGELICAN_H */