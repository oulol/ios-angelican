diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..e376624 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -145,6 +145,22 @@
 
 /* Macros and helpers */
 
+.macro CASA expected, desired, addr, old, status
+.Lcasa_retry\@:
+    ldaxr   \old, [\addr]
+    cmp     \old, \expected
+    b.eq    .Lcasa_store\@
+
+    clrex
+    b       .Lcasa_done\@
+
+.Lcasa_store\@:
+    stxr    \status, \desired, [\addr]
+    cbnz    \status, .Lcasa_retry\@
+
+.Lcasa_done\@:
+.endm
+
 .macro BACKOFF lock_addr
 	// Save registers we can't clobber
 	stp		x0, x1, [sp, #-16]!
@@ -273,7 +289,7 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	CASA w10, w11, x3, w12, w13	 // Atomic CAS with acquire barrier emulation
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +339,7 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	CASA w10, w11, x2, w12, w13	 // Atomic CAS with acquire barrier emulation
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
