diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 505533a..8746363 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -40,7 +40,88 @@
 #include <arm/pmap.h>
 #endif /* __ARM_KERNEL_PROTECT__ */
 
+#if defined(ANGELICAN)
+
+.macro ANGELICAN_MARK stage
+	stp x0, x1, [sp, #-16]!
+    stp x2, x3, [sp, #-16]!
+    stp x5, x7, [sp, #-16]!
+    str x8, [sp, #-16]!
+
+    /* Framebuffer address: row = stage * 20 */
+    movz    x0, #0x0000
+    movk    x0, #0x7ec5, lsl #16
+
+    mov     x7, #0
+    mov     x8, #2944
+    madd    x0, x7, x8, x0
+
+        .if \stage == 0
+        /* Red: 0xFFFF0000 */
+        movz    w1, #0x0000
+        movk    w1, #0xffff, lsl #16
+
+    .elseif \stage == 1
+        /* Orange: 0xFFFF8000 */
+        movz    w1, #0x8000
+        movk    w1, #0xffff, lsl #16
+
+    .elseif \stage == 2
+        /* Yellow: 0xFFFFFF00 */
+        movz    w1, #0xff00
+        movk    w1, #0xffff, lsl #16
+
+    .elseif \stage == 3
+        /* Green: 0xFF00FF00 */
+        movz    w1, #0xff00
+        movk    w1, #0xff00, lsl #16
+
+    .elseif \stage == 4
+        /* Cyan: 0xFF00FFFF */
+        movz    w1, #0xffff
+        movk    w1, #0xff00, lsl #16
+
+    .elseif \stage == 5
+        /* Blue: 0xFF0000FF */
+        movz    w1, #0x00ff
+        movk    w1, #0xff00, lsl #16
+
+    .elseif \stage == 6
+        /* Violet: 0xFF8000FF */
+        movz    w1, #0x00ff
+        movk    w1, #0xff80, lsl #16
+    
+    .else
+        /* White: 0xFFFFFFFF */
+        movz    w1, #0xffff
+        movk    w1, #0xffff, lsl #16
+    .endif
+
+    /* Draw 20 rows */
+    mov     x2, #20
+
+.Langelican_row\@:
+    mov     x3, #720
+    mov     x5, x0
+
+.Langelican_pixel\@:
+    str     w1, [x5], #4
+    subs    x3, x3, #1
+    b.ne   .Langelican_pixel\@
+
+    add    x0, x0, x8
+    subs   x2, x2, #1
+    b.ne   .Langelican_row\@
+
+    dsb    sy
+
+	ldr x8, [sp], #16
+    ldp x5, x7, [sp], #16
+    ldp x2, x3, [sp], #16
+    ldp x0, x1, [sp], #16
+.endm
 
+#endif
 
 .macro MSR_VBAR_EL1_X0
 #if defined(KERNEL_INTEGRITY_KTRR)
@@ -463,6 +544,25 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(ANGELICAN)
+	/* Stage 0: white 64x32 band, no stack or page tables needed. */
+	MOV64	x0, 0x7EC50000
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #2944
+Langelican_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+Langelican_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Langelican_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Langelican_mark_row
+	dsb		sy
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -605,6 +705,28 @@ Lkernelcache_base_found:
 	/* create_bootstrap_mapping(vbase, pbase, num_ents, L1 table, freeptr) */
 	create_bootstrap_mapping x0,  x4,  x5, x1, x2, x6, x10, x11, x12, x13
 
+#if defined(ANGELICAN)
+    MOV64   x10, 0x7e000000
+
+    MOV64   x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | \
+                  ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | \
+                  ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | \
+                  ARM_TTE_BLOCK_AF | \
+                  ARM_TTE_BLOCK_PNX | \
+                  ARM_TTE_BLOCK_NX)
+
+    orr     x11, x11, x10
+
+    and     x12, x10, #(ARM_TT_L2_INDEX_MASK)
+    lsr     x12, x12, #(ARM_TT_L2_SHIFT)
+
+    add     x13, x25, #(2 * PGBYTES)
+    str     x11, [x13, x12, lsl #TTE_SHIFT]
+
+    dsb     sy
+    isb
+#endif
+
 	/* Setup the KVA bootstrap mapping */
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
@@ -612,6 +734,9 @@ Lkernelcache_base_found:
 	/* Ensure TTEs are visible */
 	dsb		ish
 
+#if defined(ANGELICAN)
+    ANGELICAN_MARK 1
+#endif
 
 	b		common_start
 
@@ -658,6 +783,9 @@ common_start:
 	mov		x19, lr
 	bl		EXT(set_mmu_ttb)
 	mov		lr, x19
+#if defined(ANGELICAN)
+    ANGELICAN_MARK 2
+#endif
 	add		x0, x25, PGBYTES
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
@@ -745,6 +873,10 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(ANGELICAN)
+    ANGELICAN_MARK 3
+#endif
+
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
 	bne		.
@@ -805,6 +937,9 @@ common_start:
 	mov	lr, x21
 #endif
 
+#if defined(ANGELICAN)
+    ANGELICAN_MARK 4
+#endif
 	// Return to arm_init()
 	ret
 
