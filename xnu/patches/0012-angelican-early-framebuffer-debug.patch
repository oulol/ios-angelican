diff --git a/osfmk/arm64/angelican_early.c b/osfmk/arm64/angelican_early.c
new file mode 100644
index 0000000..8d7a9c0
--- /dev/null
+++ b/osfmk/arm64/angelican_early.c
@@ -0,0 +1,240 @@
+
+#include <arm64/angelican_early.h>
+
+#if defined(ANGELICAN)
+
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+#define EARLY_FB          ((volatile uint32_t *)(uintptr_t)0x7EC50000)
+
+#define EARLY_WIDTH       720u
+#define EARLY_HEIGHT     1600u
+#define EARLY_STRIDE     (2944u / sizeof(uint32_t))
+
+#define EARLY_SCALE      1u
+#define EARLY_CELL_W    (8u * EARLY_SCALE)
+#define EARLY_CELL_H    (16u * EARLY_SCALE)
+
+#define EARLY_MARK_HEIGHT 32u
+
+#define EARLY_ROWS      ((EARLY_HEIGHT - EARLY_MARK_HEIGHT) / EARLY_CELL_H)
+#define EARLY_COLS      (EARLY_WIDTH / EARLY_CELL_W)
+
+#define EARLY_BLACK     0xFF000000u
+#define EARLY_WHITE     0xFFFFFFFFu
+
+extern unsigned char iso_font[256 * 16];
+
+static unsigned int early_row;
+static unsigned int early_col;
+static unsigned int early_started;
+static unsigned int early_disabled;
+static unsigned int early_panicking;
+
+/* Forward declarations */
+static void angelican_early_string(const char *s);
+static void angelican_early_hex64(uint64_t value);
+
+/*
+ * Clear the current text row.
+ */
+static void
+angelican_early_clear_row(void)
+{
+    unsigned int y;
+    unsigned int x;
+
+    for (y = 0; y < EARLY_CELL_H; y++) {
+        volatile uint32_t *line =
+            EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+
+        for (x = 0; x < EARLY_WIDTH; x++)
+            line[x] = EARLY_BLACK;
+    }
+}
+
+/*
+ * Print one character.
+ * 8x16 bitmap font, one framebuffer pixel per font pixel.
+ */
+void
+angelican_early_putc(char c)
+{
+    unsigned int gy;
+    unsigned int gx;
+    unsigned int sx;
+    uint32_t pixel;
+    const unsigned char *glyph;
+    volatile uint32_t *line;
+
+    if (early_disabled)
+        return;
+
+	EARLY_FB[0] = 0xFF00FF00;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+    if (!early_started) {
+        early_started = 1;
+        angelican_early_clear_row();
+    }
+
+    if (c == '\r') {
+        early_col = 0;
+        return;
+    }
+
+    if (c == '\n' || early_col == EARLY_COLS) {
+        early_col = 0;
+        early_row = (early_row + 1) % EARLY_ROWS;
+
+        angelican_early_clear_row();
+
+        if (c == '\n')
+            return;
+    }
+
+    glyph = iso_font + (unsigned char)c * 16;
+
+    for (gy = 0; gy < 16; gy++) {
+        line = EARLY_FB
+            + (early_row * EARLY_CELL_H + gy * EARLY_SCALE)
+                * EARLY_STRIDE
+            + early_col * EARLY_CELL_W;
+
+        for (gx = 0; gx < 8; gx++) {
+            pixel = (glyph[gy] & (1u << gx))
+                ? EARLY_WHITE
+                : EARLY_BLACK;
+
+            for (sx = 0; sx < EARLY_SCALE; sx++)
+                line[gx * EARLY_SCALE + sx] = pixel;
+        }
+    }
+
+    early_col++;
+
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Print a null-terminated string.
+ */
+static void
+angelican_early_string(const char *s)
+{
+    if (!s)
+        return;
+
+    while (*s)
+        angelican_early_putc(*s++);
+}
+
+/*
+ * Print a 64-bit value in hexadecimal.
+ */
+static void
+angelican_early_hex64(uint64_t value)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    int shift;
+
+    for (shift = 60; shift >= 0; shift -= 4)
+        angelican_early_putc(hex[(value >> shift) & 0xF]);
+}
+
+/*
+ * Debug entry state captured from common_start.
+ */
+__attribute__((noinline, no_stack_protector))
+void
+angelican_debug_state(uint64_t x0, uint64_t lr, uint64_t sp)
+{
+    angelican_early_string("DEBUG STATE\n");
+
+    angelican_early_string("X0:  0x");
+    angelican_early_hex64(x0);
+    angelican_early_putc('\n');
+
+    angelican_early_string("LR:  0x");
+    angelican_early_hex64(lr);
+    angelican_early_putc('\n');
+
+    angelican_early_string("SP:  0x");
+    angelican_early_hex64(sp);
+    angelican_early_putc('\n');
+}
+
+/*
+ * Draw a stage indicator and print its description.
+ */
+void
+angelican_early_mark(unsigned int stage, const char *label)
+{
+    unsigned int y;
+    unsigned int x;
+    uint32_t color;
+
+    if (early_disabled || stage > 8)
+        return;
+
+    color = 0xFF00FF00u | (stage * 28u << 16);
+
+    for (y = EARLY_HEIGHT - EARLY_MARK_HEIGHT; y < EARLY_HEIGHT; y++) {
+        volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE;
+
+        for (x = stage * 64; x < (stage + 1) * 64; x++)
+            line[x] = color;
+    }
+
+    __asm__ volatile("dsb sy" ::: "memory");
+
+    angelican_early_string("ANGELICAN EARLY ");
+    angelican_early_putc((char)('0' + stage));
+    angelican_early_string(": ");
+    angelican_early_string(label);
+    angelican_early_putc('\n');
+}
+
+/*
+ * Print an early panic message.
+ * Does not require a current thread, allocation, or locks.
+ */
+void
+angelican_early_panic(const char *fmt, va_list *args)
+{
+    va_list copy;
+
+    if (early_disabled || early_panicking)
+        return;
+
+    early_panicking = 1;
+
+    angelican_early_string("\nANGELICAN EARLY PANIC: ");
+
+    va_copy(copy, *args);
+    _doprnt(fmt, &copy, angelican_early_putc, 16);
+    va_end(copy);
+
+    angelican_early_putc('\n');
+
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Stop using the early framebuffer before bootstrap TTBR0 is replaced.
+ */
+void
+angelican_early_disable(void)
+{
+    if (early_disabled)
+        return;
+
+    angelican_early_mark(8, "leaving bootstrap TTBR0");
+
+    __asm__ volatile("dsb sy" ::: "memory");
+
+    early_disabled = 1;
+}
+
+#endif /* ANGELICAN */
diff --git a/osfmk/arm64/angelican_early.h b/osfmk/arm64/angelican_early.h
new file mode 100644
index 0000000..2b6b0ad
--- /dev/null
+++ b/osfmk/arm64/angelican_early.h
@@ -0,0 +1,55 @@
+#ifndef _ARM64_ANGELICAN_EARLY_H_
+#define _ARM64_ANGELICAN_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#if defined(ANGELICAN)
+
+void angelican_early_putc(char c);
+void angelican_early_mark(unsigned int stage, const char *label);
+void angelican_early_panic(const char *fmt, va_list *args);
+void angelican_early_disable(void);
+
+/* Prints the original entry X0, LR, and SP values. */
+void angelican_debug_state(uint64_t x0, uint64_t lr, uint64_t sp);
+
+#else
+
+static inline void
+angelican_early_putc(char c)
+{
+    (void)c;
+}
+
+static inline void
+angelican_early_mark(unsigned int stage, const char *label)
+{
+    (void)stage;
+    (void)label;
+}
+
+static inline void
+angelican_early_panic(const char *fmt, va_list *args)
+{
+    (void)fmt;
+    (void)args;
+}
+
+static inline void
+angelican_early_disable(void)
+{
+}
+
+static inline void
+angelican_debug_state(uint64_t x0, uint64_t lr, uint64_t sp)
+{
+    (void)x0;
+    (void)lr;
+    (void)sp;
+}
+
+#endif /* ANGELICAN */
+
+#endif /* _ARM64_ANGELICAN_EARLY_H_ */
\ No newline at end of file
