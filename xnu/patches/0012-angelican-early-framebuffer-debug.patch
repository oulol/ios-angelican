diff --git a/osfmk/arm64/angelican_early.c b/osfmk/arm64/angelican_early.c
new file mode 100644
index 0000000..5c7bd0d
--- /dev/null
+++ b/osfmk/arm64/angelican_early.c
@@ -0,0 +1,131 @@
+/*
+ * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
+ * per-CPU state: panic() can reach this before a current thread exists.
+ * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
+ * Stop using that mapping before arm_vm_init tears down bootstrap TTBR0.
+ */
+#include <arm64/angelican_early.h>
+
+#if defined(ANGELICAN)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+#define EARLY_FB ((volatile uint32_t *)(uintptr_t)0x7EC50000)
+#define EARLY_WIDTH 720u
+#define EARLY_HEIGHT 1600u
+#define EARLY_STRIDE_BYTES 2944u
+#define EARLY_STRIDE (EARLY_STRIDE_BYTES / sizeof(uint32_t))
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_row, early_col;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static void
+angelican_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+void
+angelican_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		angelican_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = (early_row + 1) % EARLY_ROWS;
+		angelican_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = EARLY_FB +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+angelican_early_string(const char *s)
+{
+	while (*s) {
+		angelican_early_putc(*s++);
+	}
+}
+
+void
+angelican_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 8) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | (stage * 28u << 16);
+	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+		for (unsigned int x = stage * 64; x < (stage + 1) * 64; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	angelican_early_string("EARLY ");
+	angelican_early_putc((char)('0' + stage));
+	angelican_early_string(": ");
+	angelican_early_string(label);
+	angelican_early_putc('\n');
+}
+
+void
+angelican_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	angelican_early_string("\nEARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, angelican_early_putc, 16);
+	va_end(copy);
+	angelican_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+angelican_early_disable(void)
+{
+	angelican_early_mark(8, "leaving bootstrap TTBR0");
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* ANGELICAN */
diff --git a/osfmk/arm64/angelican_early.h b/osfmk/arm64/angelican_early.h
new file mode 100644
index 0000000..328bc14
--- /dev/null
+++ b/osfmk/arm64/angelican_early.h
@@ -0,0 +1,22 @@
+/* Early screen diagnostics, valid only while the bootstrap TTBR0 is live. */
+#ifndef _ARM64_ANGELICAN_EARLY_H_
+#define _ARM64_ANGELICAN_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+
+#if defined(ANGELICAN)
+void angelican_early_mark(unsigned int stage, const char *label);
+void angelican_early_putc(char c);
+void angelican_early_panic(const char *fmt, va_list *args);
+void angelican_early_disable(void);
+#else
+static inline void angelican_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void angelican_early_disable(void) {}
+#endif
+
+#endif
