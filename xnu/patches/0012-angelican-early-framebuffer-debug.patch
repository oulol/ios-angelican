diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index e5336e5..9d8701c 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -40,7 +40,60 @@
 #include <arm/pmap.h>
 #endif /* __ARM_KERNEL_PROTECT__ */
 
+#if defined(ANGELICAN)
+
+.macro ANGELICAN_MARKER fb, color, rows, stride, pixels, tmp
+	/* x0 = framebuffer address */
+	MOV64	\fb, 0x7EC50000
+
+	/* Select ARGB8888 color */
+	.if \color == 0
+		mov	\tmp, #0xFFFF
+		movk	\tmp, #0xFFFF, lsl #16	/* White */
+	.elseif \color == 1
+		mov	\tmp, #0x00FF
+		movk	\tmp, #0xFFFF, lsl #16	/* Red */
+	.elseif \color == 2
+		mov	\tmp, #0x80FF
+		movk	\tmp, #0xFFFF, lsl #16	/* Orange */
+	.elseif \color == 3
+		mov	\tmp, #0xFF00
+		movk	\tmp, #0xFFFFFF00, lsl #16	/* Yellow */
+	.elseif \color == 4
+		mov	\tmp, #0xFF00
+		movk	\tmp, #0xFF00, lsl #16	/* Green */
+	.elseif \color == 5
+		mov	\tmp, #0xFFFF
+		movk	\tmp, #0xFF00, lsl #16	/* Cyan */
+	.elseif \color == 6
+		mov	\tmp, #0xFF
+		movk	\tmp, #0xFFFF, lsl #16	/* Blue */
+	.elseif \color == 7
+		mov	\tmp, #0x80FF
+		movk	\tmp, #0x8000, lsl #16	/* Purple */
+	.else
+		.error "Invalid ANGELICAN_FILL_SCREEN color"
+	.endif
+
+	mov	\rows, #32
+	mov	\stride, #2944
+
+.Langelican_fill_row\@:
+	mov	\pixels, #720
+
+.Langelican_fill_pixel\@:
+	str	\tmp, [\fb], #4
+	subs	\pixels, \pixels, #1
+	b.ne	.Langelican_fill_pixel\@
+
+	add	\fb, \fb, \stride
+	subs	\rows, \rows, #1
+	b.ne	.Langelican_fill_row\@
+
+	dsb	sy
+.endm
 
+#endif
 
 .macro MSR_VBAR_EL1_X0
 #if defined(KERNEL_INTEGRITY_KTRR)
@@ -463,6 +516,10 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(ANGELICAN)
+    ANGELICAN_FILL_SCREEN x9, 0, x10, x11, x12, x13
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -605,6 +662,32 @@ Lkernelcache_base_found:
 	/* create_bootstrap_mapping(vbase, pbase, num_ents, L1 table, freeptr) */
 	create_bootstrap_mapping x0,  x4,  x5, x1, x2, x6, x10, x11, x12, x13
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x16, 1, x17, x18, x19, x8
+#endif
+
+#if defined(ANGELICAN)
+    MOV64   x10, 0x7e000000
+
+    MOV64   x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | \
+                  ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | \
+                  ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | \
+                  ARM_TTE_BLOCK_AF | \
+                  ARM_TTE_BLOCK_PNX | \
+                  ARM_TTE_BLOCK_NX)
+
+    orr     x11, x11, x10
+
+    and     x12, x10, #(ARM_TT_L2_INDEX_MASK)
+    lsr     x12, x12, #(ARM_TT_L2_SHIFT)
+
+    add     x13, x25, #(2 * PGBYTES)
+    str     x11, [x13, x12, lsl #TTE_SHIFT]
+
+    dsb     sy
+    isb
+#endif
+
 	/* Setup the KVA bootstrap mapping */
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
@@ -612,7 +695,9 @@ Lkernelcache_base_found:
 	/* Ensure TTEs are visible */
 	dsb		ish
 
-
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x16, 2, x17, x18, x19, x8
+#endif
 	b		common_start
 
 /*
@@ -633,6 +718,10 @@ Lkernelcache_base_found:
  */
 common_start:
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x9, 3, x10, x11, x12, x13
+#endif
+
 #if HAS_NEX_PG
 	mov x19, lr
 	bl		EXT(set_nex_pg)
@@ -662,6 +751,10 @@ common_start:
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x9, 4, x10, x11, x12, x13
+#endif
+
 	// Set up MAIR attr0 for normal memory, attr1 for device memory
 	mov		x0, xzr
 	mov		x1, #(MAIR_WRITEBACK << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITEBACK))
@@ -685,6 +778,10 @@ common_start:
 	tlbi	vmalle1
 	dsb		ish
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x9, 5, x10, x11, x12, x13
+#endif
+
 
 #if defined(BCM2837)
 	// Setup timer interrupt routing; must be done before MMU is enabled
@@ -751,6 +848,10 @@ common_start:
 	bne		.
 #endif /* !VMAPPLE && !ANGELICAN */
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x9, 6, x10, x11, x12, x13
+#endif
+
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
 	 *
@@ -807,6 +908,10 @@ common_start:
 	mov	lr, x21
 #endif
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x9, 7, x10, x11, x12, x13
+#endif
+
 	// Return to arm_init()
 	ret
 
