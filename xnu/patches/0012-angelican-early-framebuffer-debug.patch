 	mov		x1, #(MAIR_WRITEBACK << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITEBACK))
@@ -685,6 +827,10 @@ common_start:
 	tlbi	vmalle1
 	dsb		ish
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x9, 4, x10, x11, x12, w13
