 #include <pexpert/arm64/boot.h>
@@ -1812,6 +1813,65 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
 
+#if defined(ANGELICAN)
+/*
+ * The reserved low-globals/kernel region is excluded from VM allocation.
+ * Use the otherwise empty 32MB block above low globals and below gVirtBase
+ * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ */
+#define ANGELICAN_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+
+#define ANGELICAN_EARLY_FB_PA        0x7EC50000ULL
+#define ANGELICAN_EARLY_FB_PA_BASE   0x7EC00000ULL
+#define ANGELICAN_EARLY_FB_OFFSET   (ANGELICAN_EARLY_FB_PA - ANGELICAN_EARLY_FB_PA_BASE)
+#define ANGELICAN_EARLY_FB_BLOCKS    3
+#define ANGELICAN_EARLY_FB_MAP_SIZE  (ANGELICAN_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE)
+
+static void
+angelican_early_map_final(void)
+{
+    const vm_map_address_t va = ANGELICAN_EARLY_FB_VA;
+
+    assert((va & ARM_TT_L2_OFFMASK) == 0);
+    assert(va + ANGELICAN_EARLY_FB_MAP_SIZE <= gVirtBase);
+
+    /* Ensure all three blocks fit in the same L2 table. */
+    assert((va & ARM_TT_L1_INDEX_MASK) ==
+        ((va + ANGELICAN_EARLY_FB_MAP_SIZE - 1) & ARM_TT_L1_INDEX_MASK));
+
+    tt_entry_t l1 =
+        cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+
+    assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) ==
+        (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+
+    tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+
+    const unsigned int first =
+        (unsigned int)((va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+
+    for (unsigned int i = 0; i < ANGELICAN_EARLY_FB_BLOCKS; i++) {
+        tt_entry_t *slot = &l2[first + i];
+
+        assert(*slot == ARM_TTE_EMPTY);
+
+        const uint64_t pa =
+            ANGELICAN_EARLY_FB_PA_BASE + ((uint64_t)i * ARM_TT_L2_SIZE);
+
+        *slot = (pa & ARM_TTE_BLOCK_L2_MASK) |
+            ARM_TTE_VALID |
+            ARM_TTE_TYPE_BLOCK |
+            ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+            ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+            ARM_TTE_BLOCK_AF |
+            ARM_TTE_BLOCK_PNX |
+            ARM_TTE_BLOCK_NX;
+    }
+
+    __asm__ volatile("dsb ishst" ::: "memory");
+}
+#endif
+
