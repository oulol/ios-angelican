+.macro ANGELICAN_MARKER fb, color, rows, stride, pixels, tmp
+	/* x0 = framebuffer address */
+	MOV64	\fb, 0x7EC50000
+
+	/* Select ARGB8888 color */
+	.if \color == 0
+       mov     \tmp, #0xFFFF
+       movk    \tmp, #0xFFFF, lsl #16    /* White   FF FF FF FF */
+   	.elseif \color == 1
+   	    mov     \tmp, #0x0000
+   	    movk    \tmp, #0xFFFF, lsl #16    /* Red    FF FF 00 00 */
+   	.elseif \color == 2
+   	    mov     \tmp, #0x8000
+   	    movk    \tmp, #0xFFFF, lsl #16    /* Orange FF FF 80 00 */
+   	.elseif \color == 3
+   	    mov     \tmp, #0xFF00
+   	    movk    \tmp, #0xFFFF, lsl #16    /* Yellow FF FF FF 00 */
+   	.elseif \color == 4
+   	    mov     \tmp, #0xFF00
+   	    movk    \tmp, #0xFF00, lsl #16    /* Green  FF 00 FF 00 */
+   	.elseif \color == 5
+   	    mov     \tmp, #0xFFFF
+   	    movk    \tmp, #0xFF00, lsl #16    /* Cyan   FF 00 FF FF */
+   	.elseif \color == 6
+   	    mov     \tmp, #0x00FF
+   	    movk    \tmp, #0xFF00, lsl #16    /* Blue   FF 00 00 FF */
+   	.elseif \color == 7
+   	    mov     \tmp, #0x0080
+   	    movk    \tmp, #0xFF80, lsl #16    /* Purple FF 80 00 80 */
+   	.else
+   	    .error "Invalid ANGELICAN_MARKER color"
+   	.endif
+
+	mov	\rows, #(10 + ((7-\color) * 10))
+	mov	\stride, #64
+
+.Langelican_fill_row\@:
+	mov	\pixels, #720
+
+.Langelican_fill_pixel\@:
+	str	\tmp, [\fb], #4
+	subs	\pixels, \pixels, #1
+	b.ne	.Langelican_fill_pixel\@
+
+	add	\fb, \fb, \stride
+	subs	\rows, \rows, #1
+	b.ne	.Langelican_fill_row\@
+
+	dsb	sy
