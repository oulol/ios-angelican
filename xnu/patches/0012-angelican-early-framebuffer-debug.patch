diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 4592d55..293984b 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -40,14 +40,66 @@
 #include <arm/pmap.h>
 #endif /* __ARM_KERNEL_PROTECT__ */
 
+#if defined(ANGELICAN)
+
+.macro ANGELICAN_MARKER fb, color, rows, stride, pixels, tmp
+	/* x0 = framebuffer address */
+	MOV64	\fb, 0x7EC50000
+
+	/* Select ARGB8888 color */
+	.if \color == 0
+       mov     \tmp, #0xFFFF
+       movk    \tmp, #0xFFFF, lsl #16    /* White   FF FF FF FF */
+   	.elseif \color == 1
+   	    mov     \tmp, #0x0000
+   	    movk    \tmp, #0xFFFF, lsl #16    /* Red    FF FF 00 00 */
+   	.elseif \color == 2
+   	    mov     \tmp, #0x8000
+   	    movk    \tmp, #0xFFFF, lsl #16    /* Orange FF FF 80 00 */
+   	.elseif \color == 3
+   	    mov     \tmp, #0xFF00
+   	    movk    \tmp, #0xFFFF, lsl #16    /* Yellow FF FF FF 00 */
+   	.elseif \color == 4
+   	    mov     \tmp, #0xFF00
+   	    movk    \tmp, #0xFF00, lsl #16    /* Green  FF 00 FF 00 */
+   	.elseif \color == 5
+   	    mov     \tmp, #0xFFFF
+   	    movk    \tmp, #0xFF00, lsl #16    /* Cyan   FF 00 FF FF */
+   	.elseif \color == 6
+   	    mov     \tmp, #0x00FF
+   	    movk    \tmp, #0xFF00, lsl #16    /* Blue   FF 00 00 FF */
+   	.elseif \color == 7
+   	    mov     \tmp, #0x0080
+   	    movk    \tmp, #0xFF80, lsl #16    /* Purple FF 80 00 80 */
+   	.else
+   	    .error "Invalid ANGELICAN_MARKER color"
+   	.endif
+
+	mov	\rows, #(10 + ((7-\color) * 10))
+	mov	\stride, #64
+
+.Langelican_fill_row\@:
+	mov	\pixels, #720
+
+.Langelican_fill_pixel\@:
+	str	\tmp, [\fb], #4
+	subs	\pixels, \pixels, #1
+	b.ne	.Langelican_fill_pixel\@
+
+	add	\fb, \fb, \stride
+	subs	\rows, \rows, #1
+	b.ne	.Langelican_fill_row\@
+
+	dsb	sy
+.endm
 
+#endif
 
 .macro MSR_VBAR_EL1_X0
 #if defined(KERNEL_INTEGRITY_KTRR)
 	mov	x1, lr
 	bl		EXT(pinst_set_vbar)
 	mov	lr, x1
-#else
 	msr		VBAR_EL1, x0
 #endif
 .endmacro
@@ -463,6 +515,10 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(ANGELICAN)
+    ANGELICAN_MARKER x9, 0, x10, x11, x12, w13
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -609,6 +665,84 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(ANGELICAN)
+    /*
+     * Add an identity mapping for the ANGELICAN framebuffer.
+     *
+     * TTBR0 is the V=P table, so VA == PA.
+     * The framebuffer is reserved RAM and is not inside BA_MEM_SIZE.
+     *
+     * The three 2 MiB blocks are mapped as Normal Non-Cacheable.
+     */
+
+    MOV64   x9, 0x7EC00000
+
+    // Find the L1 entry for the framebuffer.
+    and     x10, x9, #(ARM_TT_L1_INDEX_MASK)
+    lsr     x10, x10, #(ARM_TT_L1_SHIFT)
+    lsl     x10, x10, #(TTE_SHIFT)
+    add     x11, x1, x10
+
+    // Reuse its L2 table if the regular V=P mapping created one.
+    ldr     x12, [x11]
+    tbnz    x12, #1, Langelican_fb_have_l2
+
+    // Otherwise allocate another L2 table from bootstrap_pagetables.
+    add     x2, x2, PGBYTES
+
+    // Explicitly clear the new table.
+    mov     x13, #(ARM_TTE_EMPTY)
+    mov     x14, #(TTE_PGENTRIES)
+    mov     x15, x2
+
+Langelican_fb_clear:
+    str     x13, [x15], #(1 << TTE_SHIFT)
+    subs    x14, x14, #1
+    b.ne    Langelican_fb_clear
+
+    // Install the L1 -> L2 table descriptor.
+    mov     x12, #(ARM_TTE_BOOT_TABLE)
+    and     x13, x2, #(ARM_TTE_TABLE_MASK)
+    orr     x12, x12, x13
+    str     x12, [x11]
+
+    mov     x12, x2
+    b       Langelican_fb_map
+
+Langelican_fb_have_l2:
+    and     x12, x12, #(ARM_TTE_TABLE_MASK)
+
+Langelican_fb_map:
+    // Find the L2 entry corresponding to 0x7EC00000.
+    and     x10, x9, #(ARM_TT_L2_INDEX_MASK)
+    lsr     x10, x10, #(ARM_TT_L2_SHIFT)
+    lsl     x10, x10, #(TTE_SHIFT)
+    add     x12, x12, x10
+
+    // Start with the normal bootstrap block descriptor.
+    // Replace its write-back attribute with Normal Non-Cacheable.
+    mov     x13, #(ARM_TTE_BOOT_BLOCK)
+    bic     x13, x13, #(ARM_TTE_BLOCK_ATTRINDXMASK)
+    orr     x13, x13, #(ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB))
+
+    MOV64   x14, 0x7EC00000
+    mov     x15, #(ARM_TT_L2_SIZE)
+    mov     x10, #3
+
+Langelican_fb_blocks:
+    and     x11, x14, #(ARM_TTE_BLOCK_L2_MASK)
+    orr     x11, x11, x13
+    str     x11, [x12], #(1 << TTE_SHIFT)
+
+    add     x14, x14, x15
+    subs    x10, x10, #1
+    b.ne    Langelican_fb_blocks
+#endif
+
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x16, 1, x17, x18, x19, w8
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
@@ -633,6 +767,10 @@ Lkernelcache_base_found:
  */
