+
 
 #if defined(BCM2837)
 	// Setup timer interrupt routing; must be done before MMU is enabled
@@ -755,6 +901,10 @@ common_start:
 	bne		.
 #endif /* !VMAPPLE && !ANGELICAN */
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x9, 5, x10, x11, x12, w13
+#endif
+
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
 	 *
@@ -811,6 +961,34 @@ common_start:
 	mov	lr, x21
 #endif
 
+#if defined(ANGELICAN)
+	ANGELICAN_MARKER x9, 6, x10, x11, x12, w13
+
+    mov     x22, x0          // original boot args
+	ANGELICAN_MARKER x9, 0, x10, x11, x12, w13
+    mov     x23, x30         // original LR
+	ANGELICAN_MARKER x9, 1, x10, x11, x12, w13
+    mov     x24, sp          // original SP
+	ANGELICAN_MARKER x9, 2, x10, x11, x12, w13
+
+    // C arguments.
+    mov     x0, x22
+    mov     x1, x23
+    mov     x2, x24
+
+	ANGELICAN_MARKER x9, 3, x10, x11, x12, w13
+
+    bl      EXT(angelican_debug_state)
+
+	ANGELICAN_MARKER x9, 7, x10, x11, x12, w13
+
+	mov     x0, x22
+    mov     x30, x23
+    mov     sp, x24
+
+	ANGELICAN_MARKER x9, 2, x10, x11, x12, w13
+#endif
+
 	// Return to arm_init()
 	ret
 
