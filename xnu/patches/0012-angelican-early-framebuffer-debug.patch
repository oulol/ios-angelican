diff --git a/osfmk/arm64/angelican_early.c b/osfmk/arm64/angelican_early.c
new file mode 100644
index 0000000..7a759bc
--- /dev/null
+++ b/osfmk/arm64/angelican_early.c
@@ -0,0 +1,173 @@
+
+#include <arm64/angelican_early.h>
+
+#if defined(ANGELICAN)
+
+#include <stdint.h>
+
+/* Framebuffer configuration */
+#define EARLY_FB             ((volatile uint32_t *)(uintptr_t)0x7EC50000)
+
+#define EARLY_WIDTH          720u
+#define EARLY_HEIGHT         1600u
+#define EARLY_STRIDE         (2944u / sizeof(uint32_t))
+
+#define EARLY_MARK_HEIGHT    32u
+#define EARLY_MARK_Y         (EARLY_HEIGHT - EARLY_MARK_HEIGHT)
+#define EARLY_STAGE_WIDTH    64u
+#define EARLY_MAX_STAGE      8u
+
+/* ARGB8888 colors */
+#define EARLY_COLOR_BLACK    0xFF000000u
+#define EARLY_COLOR_WHITE    0xFFFFFFFFu
+#define EARLY_COLOR_RED      0xFFFF0000u
+#define EARLY_COLOR_ORANGE   0xFFFF8000u
+#define EARLY_COLOR_YELLOW   0xFFFFFF00u
+#define EARLY_COLOR_GREEN    0xFF00FF00u
+#define EARLY_COLOR_CYAN     0xFF00FFFFu
+#define EARLY_COLOR_BLUE     0xFF0000FFu
+#define EARLY_COLOR_PURPLE   0xFF8000FFu
+#define EARLY_COLOR_MAGENTA  0xFFFF00FFu
+
+static unsigned int early_disabled;
+
+/*
+ * Fill a horizontal framebuffer region.
+ *
+ * Coordinates are clipped to the framebuffer dimensions.
+ */
+static void
+angelican_early_fill(
+    unsigned int x0,
+    unsigned int y0,
+    unsigned int width,
+    unsigned int height,
+    uint32_t color)
+{
+    unsigned int x;
+    unsigned int y;
+
+    if (x0 >= EARLY_WIDTH || y0 >= EARLY_HEIGHT)
+        return;
+
+    if (width > EARLY_WIDTH - x0)
+        width = EARLY_WIDTH - x0;
+
+    if (height > EARLY_HEIGHT - y0)
+        height = EARLY_HEIGHT - y0;
+
+    for (y = y0; y < y0 + height; y++) {
+        volatile uint32_t *line =
+            EARLY_FB + y * EARLY_STRIDE + x0;
+
+        for (x = 0; x < width; x++)
+            line[x] = color;
+    }
+
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Draw a stage indicator in the bottom framebuffer strip.
+ */
+void
+angelican_early_mark(unsigned int stage, const char *label)
+{
+    static const uint32_t colors[] = {
+        EARLY_COLOR_WHITE,
+        EARLY_COLOR_RED,
+        EARLY_COLOR_ORANGE,
+        EARLY_COLOR_YELLOW,
+        EARLY_COLOR_GREEN,
+        EARLY_COLOR_CYAN,
+        EARLY_COLOR_BLUE,
+        EARLY_COLOR_PURPLE,
+        EARLY_COLOR_MAGENTA
+    };
+
+    (void)label;
+
+    if (early_disabled || stage > EARLY_MAX_STAGE)
+        return;
+
+    angelican_early_fill(
+        stage * EARLY_STAGE_WIDTH,
+        EARLY_MARK_Y,
+        EARLY_STAGE_WIDTH,
+        EARLY_MARK_HEIGHT,
+        colors[stage]
+    );
+}
+
+/*
+ * Debug entry state marker.
+ * Green means angelican_debug_state() was reached.
+ */
+__attribute__((noinline, no_stack_protector))
+void
+angelican_debug_state(uint64_t x0, uint64_t lr, uint64_t sp)
+{
+    (void)x0;
+    (void)lr;
+    (void)sp;
+
+    if (early_disabled)
+        return;
+
+    angelican_early_fill(
+        0,
+        EARLY_MARK_Y,
+        EARLY_WIDTH,
+        EARLY_MARK_HEIGHT,
+        EARLY_COLOR_GREEN
+    );
+}
+
+/*
+ * Early panic marker.
+ * Red means an early panic path was reached.
+ */
+void
+angelican_early_panic(const char *fmt, va_list *args)
+{
+    (void)fmt;
+    (void)args;
+
+    if (early_disabled)
+        return;
+
+    angelican_early_fill(
+        0,
+        EARLY_MARK_Y,
+        EARLY_WIDTH,
+        EARLY_MARK_HEIGHT,
+        EARLY_COLOR_RED
+    );
+}
+
+/*
+ * Stop using the framebuffer before bootstrap TTBR0 is replaced.
+ */
+void
+angelican_early_disable(void)
+{
+    if (early_disabled)
+        return;
+
+    angelican_early_mark(8, (const char *)0);
+    early_disabled = 1;
+
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Retained for compatibility with existing console callbacks.
+ * Early diagnostics no longer render text.
+ */
+void
+angelican_early_putc(char c)
+{
+    (void)c;
+}
+
+#endif /* ANGELICAN */
diff --git a/osfmk/arm64/angelican_early.h b/osfmk/arm64/angelican_early.h
new file mode 100644
index 0000000..2b6b0ad
--- /dev/null
+++ b/osfmk/arm64/angelican_early.h
@@ -0,0 +1,55 @@
+#ifndef _ARM64_ANGELICAN_EARLY_H_
+#define _ARM64_ANGELICAN_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#if defined(ANGELICAN)
+
+void angelican_early_putc(char c);
+void angelican_early_mark(unsigned int stage, const char *label);
+void angelican_early_panic(const char *fmt, va_list *args);
+void angelican_early_disable(void);
+
+/* Prints the original entry X0, LR, and SP values. */
+void angelican_debug_state(uint64_t x0, uint64_t lr, uint64_t sp);
+
+#else
+
+static inline void
+angelican_early_putc(char c)
+{
+    (void)c;
+}
+
+static inline void
+angelican_early_mark(unsigned int stage, const char *label)
+{
+    (void)stage;
+    (void)label;
+}
+
+static inline void
+angelican_early_panic(const char *fmt, va_list *args)
+{
+    (void)fmt;
+    (void)args;
+}
+
+static inline void
+angelican_early_disable(void)
+{
+}
+
+static inline void
+angelican_debug_state(uint64_t x0, uint64_t lr, uint64_t sp)
+{
+    (void)x0;
+    (void)lr;
+    (void)sp;
+}
+
+#endif /* ANGELICAN */
+
+#endif /* _ARM64_ANGELICAN_EARLY_H_ */
