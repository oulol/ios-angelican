diff --git a/osfmk/arm64/angelican_early.c b/osfmk/arm64/angelican_early.c
new file mode 100644
index 0000000..30ba9e0
--- /dev/null
+++ b/osfmk/arm64/angelican_early.c
@@ -0,0 +1,109 @@
+
+#include <arm64/angelican_early.h>
+
+#if defined(ANGELICAN)
+
+#include <stdint.h>
+
+#define EARLY_FB       ((volatile uint32_t *)(uintptr_t)0x7EC50000)
+
+#define EARLY_WIDTH   720u
+#define EARLY_HEIGHT  1600u
+#define EARLY_STRIDE  (2944u / sizeof(uint32_t)) /* 736 pixels */
+
+#define EARLY_BLACK   0xFF000000u
+#define EARLY_WHITE   0xFFFFFFFFu
+
+static volatile unsigned int early_disabled;
+
+/*
+ * Fill the visible framebuffer.
+ *
+ * Stride is 736 pixels, but only 720 pixels are visible.
+ * Padding pixels are intentionally left untouched.
+ */
+static void
+angelican_early_fill(uint32_t color)
+{
+    if (early_disabled)
+        return;
+
+    for (unsigned int y = 0; y < EARLY_HEIGHT; y++) {
+        volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE;
+
+        for (unsigned int x = 0; x < EARLY_WIDTH; x++)
+            line[x] = color;
+    }
+
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Debug state:
+ * Full white screen.
+ *
+ * Called from common_start immediately before returning to arm_init().
+ */
+__attribute__((noinline, no_stack_protector))
+void
+angelican_debug_state(uint64_t x0, uint64_t lr, uint64_t sp)
+{
+    (void)x0;
+    (void)lr;
+    (void)sp;
+
+    angelican_early_fill(EARLY_WHITE);
+}
+
+/*
+ * Stage marker:
+ * Preserve the original stage-dependent color calculation.
+ *
+ * Original formula:
+ *   0xFF00FF00 | (stage * 28 << 16)
+ *
+ * Now applies the resulting color to the entire screen.
+ */
+void
+angelican_early_mark(unsigned int stage, const char *label)
+{
+    (void)label;
+
+    if (stage > 8)
+        return;
+
+    uint32_t color = 0xFF00FF00u | (stage * 28u << 16);
+
+    angelican_early_fill(color);
+}
+
+/*
+ * Early panic:
+ * Full black screen.
+ */
+void
+angelican_early_panic(const char *fmt, va_list *args)
+{
+    (void)fmt;
+    (void)args;
+
+    angelican_early_fill(EARLY_BLACK);
+}
+
+/*
+ * Disable the early framebuffer interface.
+ *
+ * Must be called before bootstrap TTBR0 is replaced.
+ */
+void
+angelican_early_disable(void)
+{
+    if (early_disabled)
+        return;
+
+    __asm__ volatile("dsb sy" ::: "memory");
+
+    early_disabled = 1;
+}
+
+#endif /* ANGELICAN */
