diff --git a/osfmk/arm64/angelican_early.c b/osfmk/arm64/angelican_early.c
new file mode 100644
index 0000000..3b01886
--- /dev/null
+++ b/osfmk/arm64/angelican_early.c
@@ -0,0 +1,182 @@
+/*
+ * Redmi 9C NFC early framebuffer console.
+ *
+ * No allocation, locks, ADT parsing or per-CPU state: panic() can reach this
+ * before a current thread exists. start.s must identity-map the framebuffer
+ * through the bootstrap page tables. This console must be disabled before
+ * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
+ * retain this console until the normal framebuffer serial console is ready.
+ */
+#include <arm64/angelican_early.h>
+
+#if defined(ANGELICAN)
+
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+/* Redmi 9C NFC framebuffer: ARGB8888, 720x1600, 2944-byte row pitch. */
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x7EC50000;
+#define EARLY_FB               ((volatile uint32_t *)(uintptr_t)0x7EC50000)
+#define EARLY_WIDTH            720u
+#define EARLY_HEIGHT           1600u
+#define EARLY_STRIDE_BYTES     2944u
+#define EARLY_STRIDE           (EARLY_STRIDE_BYTES / sizeof(uint32_t))
+
+#define EARLY_SCALE            2u
+#define EARLY_CELL_W           (8u * EARLY_SCALE)
+#define EARLY_CELL_H           (16u * EARLY_SCALE)
+#define EARLY_ROWS             ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS             (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+/* Writable state: this console is used before normal kernel state exists. */
+static unsigned int early_row;
+static unsigned int early_col;
+static unsigned int early_started;
+static unsigned int early_disabled;
+static unsigned int early_panicking;
+
+static void
+angelican_early_clear_row(void)
+{
+    for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+        volatile uint32_t *line = EARLY_FB +
+            (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+
+        for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+            line[x] = 0xFF000000u;
+        }
+    }
+}
+
+void
+angelican_early_putc(char c)
+{
+    if (early_disabled) {
+        return;
+    }
+
+    if (!early_started) {
+        early_started = 1;
+        angelican_early_clear_row();
+    }
+
+    if (c == '\r') {
+        early_col = 0;
+        return;
+    }
+
+    if (c == '\n' || early_col == EARLY_COLS) {
+        early_col = 0;
+        early_row = (early_row + 1) % EARLY_ROWS;
+        angelican_early_clear_row();
+
+        if (c == '\n') {
+            return;
+        }
+    }
+
+    const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+
+    for (unsigned int gy = 0; gy < 16; gy++) {
+        for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+            volatile uint32_t *line = EARLY_FB +
+                (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+                early_col * EARLY_CELL_W;
+
+            for (unsigned int gx = 0; gx < 8; gx++) {
+                uint32_t pixel = (glyph[gy] & (1u << gx))
+                    ? 0xFFFFFFFFu
+                    : 0xFF000000u;
+
+                for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+                    line[gx * EARLY_SCALE + sx] = pixel;
+                }
+            }
+        }
+    }
+
+    early_col++;
+    for (volatile unsigned int i = 0; i < 10000000; i++) {
+        __asm__ volatile("nop");
+    }
+}
+
+static void
+angelican_early_string(const char *s)
+{
+    while (*s) {
+        angelican_early_putc(*s++);
+    }
+}
+
+void
+angelican_early_mark(unsigned int stage, const char *label)
+{
+    if (early_disabled || stage > 20) {
+        return;
+    }
+
+    uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+
+    /* Reserve the bottom 32 scanlines for the stage indicator. */
+    const unsigned int x_start = (stage-1) * 48;
+    const unsigned int x_end =
+        (x_start + 48 < EARLY_WIDTH) ? x_start + 48 : EARLY_WIDTH;
+
+    for (unsigned int y = EARLY_HEIGHT - 32u; y < EARLY_HEIGHT; y++) {
+        for (unsigned int x = x_start; x < x_end; x++) {
+            EARLY_FB[y * EARLY_STRIDE + x] = color;
+        }
+    }
+
+    __asm__ volatile("dsb sy" ::: "memory");
+
+    angelican_early_string("EARLY ");
+    if (stage >= 10) {
+		angelican_early_putc((char)('0' + stage / 10));
+	}
+	angelican_early_putc((char)('0' + stage % 10));
+    angelican_early_string(": ");
+    angelican_early_string(label);
+    angelican_early_putc('\n');
+}
+
+void
+angelican_early_panic(const char *fmt, va_list *args)
+{
+    if (early_disabled || early_panicking) {
+        return;
+    }
+
+    early_panicking = 1;
+    angelican_early_string("\nEARLY PANIC: ");
+
+    va_list copy;
+    va_copy(copy, *args);
+    _doprnt(fmt, &copy, angelican_early_putc, 16);
+    va_end(copy);
+
+    angelican_early_putc('\n');
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+angelican_early_relocate(uint64_t base)
+{
+	angelican_early_mark(8, "leaving bootstrap TTBR0");
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	__asm__ volatile("dsb sy" ::: "memory");
+	angelican_early_mark(9, "kernel framebuffer VA live");
+}
+
+void
+angelican_early_disable(void)
+{
+    angelican_early_mark(8, "leaving bootstrap TTBR0");
+    early_disabled = 1;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+#endif /* ANGELICAN */
