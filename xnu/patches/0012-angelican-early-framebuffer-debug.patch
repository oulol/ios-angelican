 	// From here on out, we're off the bootstrap translation tables.
 
 
@@ -2244,8 +2313,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
     }
 #endif
 #endif
+	angelican_early_mark(12, "calling pmap_bootstrap");
