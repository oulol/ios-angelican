+
+/*****************************************************************************/
+/* Angelican framebuffer console                                             */
+/*****************************************************************************/
+
+#define ANGELICAN_FBCON_BASE        0x7EC50000ULL
+#define ANGELICAN_FBCON_SIZE        0x00D8C000ULL
+#define ANGELICAN_FBCON_WIDTH       720u
+#define ANGELICAN_FBCON_HEIGHT      1600u
+#define ANGELICAN_FBCON_STRIDE      2944u
+
+#define ANGELICAN_FBCON_SCALE       2u
+#define ANGELICAN_FBCON_FG          0xFF000000u
+#define ANGELICAN_FBCON_BG          0xFFFFFFFFu
+
+#define ANGELICAN_FBCON_CHAR_WIDTH  8u
+#define ANGELICAN_FBCON_CHAR_HEIGHT 16u
+
+extern unsigned char iso_font[256 * 16];
+
+static volatile uint32_t *angelican_fb;
+static uint32_t angelican_fb_col;
+static uint32_t angelican_fb_row;
+static uint32_t angelican_fb_cols;
+static uint32_t angelican_fb_rows;
+static uint32_t angelican_fb_width;
+static uint32_t angelican_fb_height;
+static uint32_t angelican_fb_stride;
+
+static void
+angelican_fb_clear_row(uint32_t row)
+{
+    if (angelican_fb == NULL || row >= angelican_fb_rows) {
+        return;
+    }
+
+    const uint32_t stride_pixels =
+        angelican_fb_stride / sizeof(uint32_t);
+
+    const uint32_t row_start =
+        row * ANGELICAN_FBCON_CHAR_HEIGHT * ANGELICAN_FBCON_SCALE;
+
+    const uint32_t row_end =
+        row_start + ANGELICAN_FBCON_CHAR_HEIGHT *
+        ANGELICAN_FBCON_SCALE;
+
+    for (uint32_t y = row_start; y < row_end; y++) {
+        volatile uint32_t *line =
+            angelican_fb + y * stride_pixels;
+
+        for (uint32_t x = 0; x < angelican_fb_width; x++) {
+            line[x] = ANGELICAN_FBCON_BG;
+        }
+    }
+}
+
+static void
+angelican_fb_newline(void)
+{
+    angelican_fb_col = 0;
+    angelican_fb_row = (angelican_fb_row + 1) % angelican_fb_rows;
+
+    angelican_fb_clear_row(angelican_fb_row);
+    angelican_fb_clear_row(
+        (angelican_fb_row + 1) % angelican_fb_rows);
+}
+
+static void
+angelican_fb_init(void)
+{
+    if (angelican_fb == NULL) {
+        return;
+    }
+
+    angelican_fb_cols =
+        angelican_fb_width /
+        (ANGELICAN_FBCON_CHAR_WIDTH * ANGELICAN_FBCON_SCALE);
+
+    angelican_fb_rows =
+        angelican_fb_height /
+        (ANGELICAN_FBCON_CHAR_HEIGHT * ANGELICAN_FBCON_SCALE);
+
+    if (angelican_fb_cols == 0 || angelican_fb_rows == 0) {
+        return;
+    }
+
+    angelican_fb_col = 0;
+    angelican_fb_row = 0;
+
+    for (uint32_t r = 0; r < angelican_fb_rows; r++) {
+        angelican_fb_clear_row(r);
+    }
+}
+
+static unsigned int
+angelican_fb_transmit_ready(void)
+{
+    return 1;
+}
+
+static void
+angelican_fb_transmit_data(uint8_t c)
+{
+    if (angelican_fb == NULL) {
+        return;
+    }
+
+    if (c == '\r') {
+        angelican_fb_col = 0;
+        return;
+    }
+
+    if (c == '\n') {
+        angelican_fb_newline();
+        return;
+    }
+
+    if (angelican_fb_col >= angelican_fb_cols) {
+        angelican_fb_newline();
+    }
+
+    const unsigned char *glyph =
+        iso_font + c * ANGELICAN_FBCON_CHAR_HEIGHT;
+
+    const uint32_t x0 =
+        angelican_fb_col *
+        ANGELICAN_FBCON_CHAR_WIDTH *
+        ANGELICAN_FBCON_SCALE;
+
+    const uint32_t y0 =
+        angelican_fb_row *
+        ANGELICAN_FBCON_CHAR_HEIGHT *
+        ANGELICAN_FBCON_SCALE;
+
+    const uint32_t stride_pixels =
+        angelican_fb_stride / sizeof(uint32_t);
+
+    for (uint32_t gy = 0; gy < ANGELICAN_FBCON_CHAR_HEIGHT; gy++) {
+        for (uint32_t sy = 0; sy < ANGELICAN_FBCON_SCALE; sy++) {
+            volatile uint32_t *line =
+                angelican_fb +
+                (y0 + gy * ANGELICAN_FBCON_SCALE + sy) *
+                stride_pixels + x0;
+
+            for (uint32_t gx = 0; gx < ANGELICAN_FBCON_CHAR_WIDTH; gx++) {
+                const uint32_t px =
+                    (glyph[gy] & (1u << gx))
+                    ? ANGELICAN_FBCON_FG
+                    : ANGELICAN_FBCON_BG;
+
+                for (uint32_t sx = 0; sx < ANGELICAN_FBCON_SCALE; sx++) {
+                    line[gx * ANGELICAN_FBCON_SCALE + sx] = px;
+                }
+            }
+        }
+    }
+
+    angelican_fb_col++;
+}
+
+static unsigned int
+angelican_fb_receive_ready(void)
+{
+    return 0;
+}
+
+static uint8_t
+angelican_fb_receive_data(void)
+{
+    return 0;
+}
+
+static SECURITY_READ_ONLY_LATE(struct pe_serial_functions)
+angelican_fb_serial_functions =
+{
+    .init = angelican_fb_init,
+    .transmit_ready = angelican_fb_transmit_ready,
+    .transmit_data = angelican_fb_transmit_data,
+    .receive_ready = angelican_fb_receive_ready,
+    .receive_data = angelican_fb_receive_data,
+    .device = SERIAL_ANGELICAN_FBCON
+};
+
+static void
+angelican_fb_probe(void)
+{
+    DTEntry entry;
+    uint64_t const *reg;
+    uint32_t const *val;
+    unsigned int size;
+
+    /* Find the Angelican framebuffer ADT node. */
+    if (SecureDTFindEntry("name", "angelican-fbcon", &entry) != kSuccess) {
+        return;
+    }
+
+    /* Read physical framebuffer address and allocation size. */
+    if (SecureDTGetProperty(entry, "reg",
+        (void const **)&reg, &size) != kSuccess ||
+        size < 2 * sizeof(uint64_t)) {
+        return;
+    }
+
+    /* Read visible width. */
+    if (SecureDTGetProperty(entry, "width",
+        (void const **)&val, &size) != kSuccess ||
+        size < sizeof(uint32_t)) {
+        return;
+    }
+    angelican_fb_width = *val;
+
+    /* Read height. */
+    if (SecureDTGetProperty(entry, "height",
+        (void const **)&val, &size) != kSuccess ||
+        size < sizeof(uint32_t)) {
+        return;
+    }
+    angelican_fb_height = *val;
+
+    /* Read stride in bytes. */
+    if (SecureDTGetProperty(entry, "stride",
+        (void const **)&val, &size) != kSuccess ||
+        size < sizeof(uint32_t)) {
+        return;
+    }
+    angelican_fb_stride = *val;
+
+    /* Validate framebuffer geometry and allocation size. */
+    if (angelican_fb_width == 0 ||
+        angelican_fb_height < ANGELICAN_FBCON_CHAR_HEIGHT *
+            ANGELICAN_FBCON_SCALE ||
+        angelican_fb_stride < angelican_fb_width * sizeof(uint32_t) ||
+        (angelican_fb_stride % sizeof(uint32_t)) != 0 ||
+        (uint64_t)angelican_fb_stride * angelican_fb_height > reg[1]) {
+        return;
+    }
+
+    /* Map physical framebuffer into kernel virtual address space. */
+    angelican_fb = (volatile uint32_t *)
+        ml_io_map_wcomb(reg[0], reg[1]);
+
+    if (angelican_fb != NULL) {
+        register_serial_functions(&angelican_fb_serial_functions);
+    }
+}
+
 #if HIBERNATION
 /**
  * Transitions the serial driver into a mode that can be run in the hibernation
@@ -777,6 +1023,8 @@ serial_init(void)
 
 	PE_parse_boot_argn("disable-uart-irq", &disable_uart_irq, sizeof(disable_uart_irq));
 
+	angelican_fb_probe();
+
 #ifdef PI3_UART
 	if (SecureDTFindEntry("name", "gpio", &entryP) == kSuccess) {
 		SecureDTGetProperty(entryP, "reg", (void const **)&reg_prop, &prop_size);
