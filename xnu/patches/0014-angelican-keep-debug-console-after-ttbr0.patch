+/*
+ * Map the framebuffer into an otherwise unused kernel VA region.
+ * This Normal-NC alias remains available after bootstrap TTBR0 teardown.
+ *
+ * XNU uses 4 KiB pages, but ARM_TT_L2_SIZE is still 2 MiB:
+ * the framebuffer's 4.5 MiB span requires three L2 block entries.
+ */
+#define ANGELICAN_EARLY_FB_VA          (LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE)
+#define ANGELICAN_EARLY_FB_PA_BASE     0x7EC00000ULL
+#define ANGELICAN_EARLY_FB_BLOCK_COUNT 3
+#define ANGELICAN_EARLY_FB_MAP_SIZE    (ANGELICAN_EARLY_FB_BLOCK_COUNT * ARM_TT_L2_SIZE)
+#define ANGELICAN_EARLY_FB_OFFSET      (0x7EC50000ULL - ANGELICAN_EARLY_FB_PA_BASE)
+
+static void
+angelican_early_map_final(void)
+{
+    const vm_map_address_t va = ANGELICAN_EARLY_FB_VA;
+
+    assert((va & ARM_TT_L2_OFFMASK) == 0);
+    assert(va + ANGELICAN_EARLY_FB_MAP_SIZE <= gVirtBase);
+
+    /* All three blocks must be covered by the same L1 entry. */
+    assert((va & ARM_TT_L1_INDEX_MASK) ==
+        ((va + ANGELICAN_EARLY_FB_MAP_SIZE - 1) & ARM_TT_L1_INDEX_MASK));
+
+    tt_entry_t l1 = cpu_tte[
+        (va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT
+    ];
+
+    assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) ==
+        (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+
+    tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+    const unsigned int first =
+        (va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT;
+
+    for (unsigned int i = 0; i < ANGELICAN_EARLY_FB_BLOCK_COUNT; i++) {
+        tt_entry_t *slot = &l2[first + i];
+
+        assert(*slot == ARM_TTE_EMPTY);
+
+        const uint64_t pa = ANGELICAN_EARLY_FB_PA_BASE +
+            ((uint64_t)i * ARM_TT_L2_SIZE);
+
+        *slot = (pa & ARM_TTE_BLOCK_L2_MASK) |
+            ARM_TTE_VALID |
+            ARM_TTE_TYPE_BLOCK |
+            ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+            ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+            ARM_TTE_BLOCK_AF |
+            ARM_TTE_BLOCK_PNX |
+            ARM_TTE_BLOCK_NX;
+    }
+
+    __asm__ volatile("dsb ishst" ::: "memory");
+}
